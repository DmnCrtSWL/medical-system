# ========================================================
# Medical System - Variables de Entorno (Docker / VPS)
# ========================================================

# Configuración de Base de Datos PostgreSQL
POSTGRES_USER=medical_user
POSTGRES_PASSWORD=medical_secure_password_2026
POSTGRES_DB=medical_db

# Mapeo de Puertos en el Host (VPS)
# NOTA: Los puertos 5432-5437, 3000-3013 y 80/443 ya están en uso por otros proyectos en el VPS.
# Usar estos puertos asignados para evitar conflictos:
POSTGRES_PORT=5438
BACKEND_PORT=3014
FRONTEND_PORT=9193

DATABASE_URL="postgresql://medical_user:medical_secure_password_2026@localhost:5438/medical_db?schema=public"

# Seguridad y Autenticación JWT
JWT_SECRET=medical_super_secret_jwt_key_staging_2026
JWT_EXPIRES_IN=7d
NODE_ENV=production

# Configuración de Correo Electrónico (SMTP)
# Proveedores compatibles: Gmail, Mailtrap, SendGrid, Amazon SES, Brevo, o SMTP corporativo
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_contrasena_smtp
SMTP_FROM="MedSys B2B" <no-reply@medicalsystem.com>
SMTP_SECURE=false
# Opcional: especificar servicio predefinido (ej: gmail)
# SMTP_SERVICE=gmail

# URL del Frontend para enlaces de activación en correos
APP_FRONTEND_URL=http://localhost:5173
