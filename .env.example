# ========================================================
# Medical System - Variables de Entorno (Docker / VPS)
# ========================================================

# Configuración de Base de Datos PostgreSQL
POSTGRES_USER=medical_user
POSTGRES_PASSWORD=medical_secure_password_2026
POSTGRES_DB=medical_db

# Mapeo de Puertos en el Host (VPS)
# NOTA: Los puertos 5432-5437, 3000-3013 y 80/443 ya están en uso por otros proyectos en el VPS.
# Usar estos puertos asignados para evitar conflictos:
POSTGRES_PORT=5438
BACKEND_PORT=3014
FRONTEND_PORT=9193

# Seguridad y Autenticación JWT
JWT_SECRET=medical_super_secret_jwt_key_staging_2026
JWT_EXPIRES_IN=7d
NODE_ENV=production
