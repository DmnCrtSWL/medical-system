datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATIVE
  DOCTOR
  STAFF
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ContractTariff {
  TARIFF_A
  TARIFF_B
  TARIFF_C
}

enum ContractDuration {
  MONTHS_6
  MONTHS_12
  MONTHS_24
}

enum TransactionType {
  INCOME
  EXPENSE
  HONORARIUM
}

enum TransactionCategory {
  B2B_CONTRACT
  DOCTOR_HONORARIUM
  CONSULTATION_FEE
  EQUIPMENT_MAINTENANCE
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ConsultationStatus {
  COMPLETED
  FOLLOW_UP_REQUIRED
  REFERRED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor?

  @@map("users")
}

model Company {
  id                  String   @id @default(uuid())
  name                String
  legalName           String?
  representativeName  String?
  representativeTitle String?
  taxId               String?  @unique
  address             String?
  phone               String?
  email               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patients      Patient[]
  contracts     Contract[]
  doctors       Doctor[]
  transactions  Transaction[]
  consultations Consultation[]

  @@map("companies")
}

model Doctor {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty      String   @default("General")
  licenseId      String?
  university     String?
  phone          String?
  licenseFileUrl String?
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts     Contract[]
  transactions  Transaction[]
  consultations Consultation[]

  @@map("doctors")
}

model Patient {
  id             String         @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  employeeNumber String?
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consultations  Consultation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("patients")
}

model Contract {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  doctorId  String?
  doctor    Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  startDate DateTime
  endDate   DateTime
  amount    Float?
  tariff    ContractTariff?   @default(TARIFF_A)
  duration  ContractDuration? @default(MONTHS_12)
  status    ContractStatus    @default(ACTIVE)
  pdfUrl    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("contracts")
}

model Transaction {
  id          String              @id @default(uuid())
  description String
  amount      Float
  type        TransactionType     @default(INCOME)
  category    TransactionCategory @default(B2B_CONTRACT)
  status      TransactionStatus   @default(COMPLETED)
  folio       String?
  receiptUrl  String?
  companyId   String?
  company     Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  doctorId    String?
  doctor      Doctor?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  date        DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("transactions")
}

model Consultation {
  id                     String             @id @default(uuid())
  localId                String?            @unique
  patientId              String
  patient                Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId               String?
  doctor                 Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chiefComplaint         String
  symptoms               String?
  diagnosisDescription   String
  treatmentPlan          String
  prescriptionNotes      String?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  temperature            Float?
  weightKg               Float?
  heightCm               Float?
  bmi                    Float?
  status                 ConsultationStatus @default(COMPLETED)
  consultationDate       DateTime           @default(now())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("consultations")
}
